{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "t212-mcp send-digest --only-at-local-hour 7 --tz Europe/London",
    "cronSchedule": "0 6,7 * * 1-5",
    "restartPolicyType": "NEVER"
  }
}
