# Trading 212 (Settings -> API (Beta)); read-only scopes are enough.
T212_API_KEY=
T212_API_SECRET=
T212_ENV=live

# Look-through discovery agent (only used with --allow-agent / allow_agent=true).
OPENAI_API_KEY=
# T212_LLM_MODEL=gpt-6.1-sol
# T212_REASONING_EFFORT=high

# Database. Docker Compose builds the URL from POSTGRES_PASSWORD; T212_DATABASE_URL is for running on the host.
# Use URL-safe characters in the password (letters, digits, - and _).
POSTGRES_PASSWORD=
T212_DATABASE_URL=postgresql+psycopg://t212:CHANGE_ME@localhost:5432/t212

# HTTP auth. Google sign-in (recommended when public):
# T212_GOOGLE_CLIENT_ID=
# T212_GOOGLE_CLIENT_SECRET=
# T212_ALLOWED_EMAILS=you@gmail.com
# T212_PUBLIC_URL=https://your-domain        # not needed on Railway
# ...or a static bearer token (generate with: openssl rand -hex 32):
T212_MCP_AUTH_TOKEN=
